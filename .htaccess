# ==============================================================================
# MOOVON SpreadPay™ - cPanel Production Apache Configuration (moovon.insure)
# ==============================================================================

# Prevent Directory Listing
Options -Indexes -MultiViews

# Set Default Index File
DirectoryIndex index.html index.htm

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------------
  # 1. Cloudflare / HTTPS Redirect (Safe with Cloudflare Flexible or Full SSL)
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP:CF-Visitor} '"scheme":"http"'
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ----------------------------------------------------------------------------
  # 2. Redirect explicit .html requests to clean URLs (exclude index)
  # ----------------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteCond %{THE_REQUEST} !/index\.html [NC]
  RewriteRule ^ %1 [R=301,L]

  # ----------------------------------------------------------------------------
  # 3. Clean URL Routing: Serve .html file if it exists
  # ----------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

</IfModule>

# ------------------------------------------------------------------------------
# 4. MIME Types
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg .svgz
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType application/json .json
  AddType text/css .css
  AddType text/javascript .js
</IfModule>

# ------------------------------------------------------------------------------
# 5. GZIP / Deflate Compression
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

# ------------------------------------------------------------------------------
# 6. Browser Caching
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML - Short cache for instant content updates
  ExpiresByType text/html "access plus 0 seconds"

  # Stylesheets and Scripts
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Media Assets
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 7. Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
